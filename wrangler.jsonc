{
  // Nombre del Worker (será la URL el-hub.<tu-subdominio>.workers.dev)
  "name": "el-hub",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "HUB",
      // Paso 2 de la guía: pega aquí el ID de tu KV namespace
      "id": "39c09598e6eb4df59df51613f560e67e"
    }
  ],
  "observability": { "enabled": true }
}
